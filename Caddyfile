# Remember, Railway terminates TLS before it gets to Caddy.
#
# Upstreams are reached over Railway private networking. Override with the
# API_UPSTREAM / STREAMLIT_UPSTREAM variables if service names or ports differ.
:8080

# Flask auth endpoints (routes are registered with the /auth prefix,
# so the path is passed through unchanged).
handle /auth/* {
	reverse_proxy {$API_UPSTREAM:api.railway.internal:5050}
}

# Everything else goes to the Streamlit frontend (websockets are proxied automatically).
handle {
	reverse_proxy {$STREAMLIT_UPSTREAM:streamlit.railway.internal:8501}
}
